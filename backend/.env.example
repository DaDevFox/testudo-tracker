# Copy to backend/.env and tailor values
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=testudo-index
MONGODB_WATCHES_COLLECTION=user-watches

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=your-email@example.com
SMTP_PASSWORD=app-password-here
EMAIL_FROM=your-email@example.com

SCRAPER_TERM_ID=202408
SCRAPER_CRON=*/30 7-23 * * MON-SAT;*/30 17-23 * * SUN
SCRAPER_NOTIFICATION_COOLDOWN_MINUTES=60
SCRAPER_REQUEST_TIMEOUT=15
SCRAPER_REQUEST_RETRIES=3
SCRAPER_SEAT_THRESHOLD=1
SCRAPER_TIMEZONE=America/New_York
